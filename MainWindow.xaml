<Window x:Class="PUBGFlagChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PUBG Observer Package Manager"
        Icon="/pubgFlagChanger.png"
        Height="550"
        Width="900">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Destination">

            <StackPanel>

                <DockPanel>

                    <TextBox
                        Text="{Binding DestinationFolder}"
                        Margin="5"/>

                    <Button
                        Content="Browse"
                        Width="100"
                        Margin="5"
                        Command="{Binding BrowseCommand}"
                        DockPanel.Dock="Right"/>

                </DockPanel>

                <TextBlock
                    Margin="8,0,8,6"
                    Text="{Binding UsedPackageName, StringFormat=Used package: {0}}"/>

            </StackPanel>

        </GroupBox>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Available Packages">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button
                            Content="Add Folder"
                            Width="100"
                            Margin="0,0,5,0"
                            Command="{Binding AddFolderCommand}"/>
                        <Button
                            Content="Remove"
                            Width="90"
                            Margin="0,0,5,0"
                            Command="{Binding RemovePackageCommand}"/>
                        <Button
                            Content="Rename"
                            Width="90"
                            Command="{Binding RenamePackageCommand}"/>
                    </StackPanel>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding Packages}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="IsSelected"
                                        Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate>
                                <Grid Background="Transparent">
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUsedPackage}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Details">

                <StackPanel Margin="10">

                    <TextBlock
                        Text="{Binding SelectedPackage.Name}"/>

                    <TextBlock
                        Text="{Binding SelectedPackage.TeamCount,
                               StringFormat=Teams: {0}}"/>

                    <TextBlock
                        Text="{Binding SelectedPackage.IconCount,
                               StringFormat=Icons: {0}}"/>

                </StackPanel>

            </GroupBox>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="{Binding Status}"
                VerticalAlignment="Center"
                Margin="5"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button
                    Content="Import ZIP"
                    Width="120"
                    Margin="5"
                    Command="{Binding ImportCommand}"/>

                <Button
                    Content="Apply Package"
                    Width="120"
                    Margin="5"
                    Command="{Binding ApplyCommand}"/>

                <Button
                    Content="Launch Game"
                    Width="120"
                    Margin="5"
                    Command="{Binding LaunchGameCommand}"/>

                <Button
                    Content="Kill Game"
                    Width="120"
                    Margin="5"
                    Command="{Binding KillGameCommand}"/>

            </StackPanel>
        </Grid>

    </Grid>

</Window>